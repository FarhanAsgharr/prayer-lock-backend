# Prayer Lock backend — environment template.
#
# Copy to .env for local development (`cp .env.example .env`), or set these as
# environment variables in your host's dashboard for production. Every field
# maps to app/core/config.py (Settings). Defaults shown are the app's own
# fallbacks; anything without a safe default is required in production.
#
# .env is git-ignored and must never be committed. No real secret belongs in
# this file — it is a template of names, not values.

# --- Application ------------------------------------------------------------
# One of: local | test | staging | production
# Setting this to "production" turns on the guard that REJECTS the default JWT
# secret, so a misconfigured prod deploy fails loudly instead of shipping an
# insecure signing key.
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database (REQUIRED in production) --------------------------------------
# PostgreSQL DSN. Use a POOLED connection string on serverless hosts (Vercel),
# because each function invocation opens its own connection.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Providers: Neon, Supabase, Railway, Render, Vercel Postgres.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/prayerlock

# --- Redis (optional; rate limiting fails open without it) ------------------
# Used for API rate limiting. If absent, rate limiting is disabled (safe, but
# the API is unthrottled). Providers: Upstash, Railway, Render.
REDIS_URL=redis://localhost:6379/0

# --- Auth (REQUIRED in production) ------------------------------------------
# Signing key for the backend's own short-lived JWTs. MUST be a strong random
# value in production — the default is rejected when ENVIRONMENT=production.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Path to the Firebase service-account JSON, if you use Firebase to verify
# user identity. Absent in local/test, where verification is stubbed.
# On serverless, write the JSON to a tmp path at boot or use a secret mount.
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase.json

# --- AI vision verification -------------------------------------------------
# Provider for prayer-mat photo verification: openai | gemini | stub
# "stub" (the default) approves without calling any API — correct for local and
# test. Set a real provider AND its key to enable actual verification.
VISION_PROVIDER=stub
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
VISION_TIMEOUT_SECONDS=20
